# PostgreSQL Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hono_commerce_db

# Better Auth Secret (Generate via `openssl rand -base64 32`)
BETTER_AUTH_SECRET=changeme_must_be_at_least_32_characters_long_secret_key!
BETTER_AUTH_URL=http://localhost:3000

# Allowed CORS Origins (comma-separated for multi-frontend)
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# Dashboard / Merchant Portal URL
DASHBOARD_URL=http://localhost:3002

# Server Port
PORT=3000
NODE_ENV=development

# Optional Integrations
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379


# AWS Secrets
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""
AWS_S3_ENDPOINT=""
