{
  "name": "api",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile api",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@bull-board/api": "catalog:",
    "@bull-board/hono": "catalog:",
    "@hono-commerce/auth": "workspace:*",
    "@hono-commerce/db": "workspace:*",
    "@hono-commerce/env": "workspace:*",
    "@hono-commerce/queue": "workspace:*",
    "@hono-commerce/types": "workspace:*",
    "@hono/zod-validator": "^0.9.0",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hono-commerce/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  }
}
