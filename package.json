{
  "name": "hono-commerce",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "next": "^16.3.0",
      "@swc/helpers": "^0.5.23",
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/bun": "^1.3.14",
      "hono": "^4.12.32",
      "better-auth": "1.7.1",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.17",
      "@types/node": "^26.2.0",
      "@types/react-dom": "^19.2.3",
      "@tanstack/react-query": "^5.67.2",
      "@tanstack/react-query-devtools": "^5.67.2",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "^0.45.2",
      "@types/pg": "^8.20.0",
      "@hookform/resolvers": "^5.9.1",
      "react-hook-form": "^7.86.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:storefront": "turbo run dev -F storefront --",
    "dev:dashboard": "turbo run dev -F dashboard --",
    "dev:api": "turbo run dev -F api --",
    "dev:realtime": "turbo run dev -F realtime --",
    "dev:worker": "turbo run dev -F worker --",
    "db:push": "turbo run db:push -F @hono-commerce/db --",
    "db:studio": "turbo run db:studio -F @hono-commerce/db --",
    "db:generate": "turbo run db:generate -F @hono-commerce/db --",
    "db:migrate": "turbo run db:migrate -F @hono-commerce/db --",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "oxlint && oxfmt --write",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono-commerce/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hono-commerce/config": "workspace:*",
    "@types/bun": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*": [
      "oxlint",
      "oxfmt --write"
    ]
  },
  "packageManager": "bun@1.3.14"
}
